# Copy to .env.production.local only for local administration of the hosted DB.
# Enter these variables in Render's Environment panel for the deployed API.
NODE_ENV=production
API_HOST=0.0.0.0
TRUST_PROXY=1
CORS_ORIGINS=https://woof-paws.vercel.app
JWT_SECRET=
DB_HOST=your-service.aivencloud.com
DB_PORT=your-aiven-port
DB_NAME=defaultdb
DB_USER=avnadmin
DB_PASSWORD=
DB_SSL=true
# Render Secret File path; locally point this to your downloaded CA certificate.
DB_SSL_CA_PATH=/etc/secrets/ca.pem
# Render supplies RENDER_EXTERNAL_URL automatically. Optional custom API origin:
# PUBLIC_API_URL=https://your-api.onrender.com
