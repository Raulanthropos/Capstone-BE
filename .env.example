# Local development defaults matching compose.yaml.
# These credentials are only for the local Docker database.
PORT=3001
API_HOST=127.0.0.1
# Run npm run auth:setup to generate a private local value in .env.
JWT_SECRET=
DB_HOST=127.0.0.1
DB_PORT=3307
DB_NAME=woof_paws
DB_USER=woof_paws
DB_PASSWORD=local-app-only

# Hosted deployments use TLS and the provider CA; see .env.production.example.
DB_SSL=false
# DB_SSL_CA_PATH=
TRUST_PROXY=0
# CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# PUBLIC_API_URL=
